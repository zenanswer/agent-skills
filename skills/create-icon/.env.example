# Icon Skill - Multi-Provider Configuration
#
# This file is a template. Copy it to `.env` in the same directory:
#   cp .env.example .env
# Then fill in your real API key.
#
# The scripts auto-load this .env file as a fallback when the
# environment variable is not already set in the shell.
# Precedence: shell env > .env file > built-in defaults.
#
# ---------------------------------------------------------------------------
# Generic (works for all providers)
# ---------------------------------------------------------------------------
# Choose the provider: minimax | qwen | openai | openai-compatible
ICON_PROVIDER=minimax

# API key for the selected provider
ICON_API_KEY=your-api-key-here

# API host / base URL (provider-specific defaults apply if omitted)
# - minimax:           https://api.minimaxi.com  (or https://api.minimax.io for global)
# - qwen:              https://dashscope.aliyuncs.com
# - openai:            https://api.openai.com
# - openai-compatible: MUST be set (e.g. https://api.siliconflow.cn)
# ICON_API_HOST=https://api.minimaxi.com

# Image generation model (provider-specific defaults apply if omitted)
# - minimax:           image-01
# - qwen:              qwen-image-2.0-pro  (also: qwen-image-plus / qwen-image-max)
# - openai:            dall-e-3
# - openai-compatible: MUST be set (e.g. Kolors, flux.1-schnell)
# ICON_MODEL=image-01

# VLM model for analyze_style.py (provider-specific defaults apply if omitted)
# - minimax:           MiniMax-M1
# - qwen:              qwen-vl-max
# - openai:            gpt-4o
# - openai-compatible: MUST be set (e.g. Qwen/Qwen2-VL-72B-Instruct)
# ICON_VLM_MODEL=MiniMax-M1

# ---------------------------------------------------------------------------
# Legacy aliases (backward compatible - only used when ICON_PROVIDER=minimax)
# ---------------------------------------------------------------------------
# Get your MiniMax key from:
#   https://platform.minimaxi.com/user-center/basic-information/interface-key
# The MiniMax coding-plan key (sk-cp-...) also works for image generation.
# MINIMAX_API_KEY=sk-cp-your-key-here
# MINIMAX_API_HOST=https://api.minimaxi.com

# ---------------------------------------------------------------------------
# Provider quick-reference
# ---------------------------------------------------------------------------
# Qwen (Aliyun DashScope):
#   Get key: https://bailian.console.aliyun.com/?apiKey=1#/api-key
#   Docs:    https://help.aliyun.com/zh/model-studio/qwen-image-api
#   ICON_PROVIDER=qwen
#   ICON_API_KEY=sk-xxxxx
#   ICON_MODEL=qwen-image-2.0-pro       # or qwen-image-plus / qwen-image-max
#   ICON_VLM_MODEL=qwen-vl-max
#
# OpenAI official:
#   Get key: https://platform.openai.com/api-keys
#   ICON_PROVIDER=openai
#   ICON_API_KEY=sk-xxxxx
#   ICON_MODEL=dall-e-3
#   ICON_VLM_MODEL=gpt-4o
#
# OpenAI-compatible gateways (SiliconFlow, Volcengine, Together, ...):
#   SiliconFlow: https://cloud.siliconflow.cn  (models: Kolors, flux.1-schnell)
#   ICON_PROVIDER=openai-compatible
#   ICON_API_HOST=https://api.siliconflow.cn
#   ICON_API_KEY=sk-xxxxx
#   ICON_MODEL=Kolors
#   ICON_VLM_MODEL=Qwen/Qwen2-VL-72B-Instruct
