# create-icon configuration template
#
# Copy to `.env` in this directory and fill in a real key:
#   cp .env.example .env
#
# Precedence: shell env > .env file > built-in defaults.
#
# ---------------------------------------------------------------------------
# Generic (works for every provider)
# ---------------------------------------------------------------------------
# minimax | qwen | ark | openai | openai-compatible
ICON_PROVIDER=minimax
ICON_API_KEY=your-api-key-here

# API host (provider defaults shown; only set to override)
# - minimax:           https://api.minimaxi.com  (global: https://api.minimax.io)
# - qwen:              https://dashscope.aliyuncs.com
# - ark:               https://ark.cn-beijing.volces.com
# - openai:            https://api.openai.com
# - openai-compatible: MUST be set (e.g. https://api.siliconflow.cn)
# ICON_API_HOST=https://api.minimaxi.com

# Image model (provider defaults shown; only set to override)
# - minimax:           image-01            (also image-01-live)
# - qwen:              qwen-image-3.0-pro  (also qwen-image-2.0-pro / max / plus)
# - ark:               doubao-seedream-5-0-pro-260628  (lite: ...-5-0-lite-260128)
# - openai:            gpt-image-1         (dall-e-3 still supported)
# - openai-compatible: MUST be set (e.g. Kolors, flux.1-schnell)
# ICON_MODEL=image-01

# VLM model for analyze_style.py
# - minimax:           MiniMax-M1
# - qwen:              qwen-vl-max
# - ark:               MUST be set (a Doubao vision model id)
# - openai:            gpt-4o
# - openai-compatible: MUST be set (e.g. Qwen/Qwen2-VL-72B-Instruct)
# ICON_VLM_MODEL=MiniMax-M1

# ---------------------------------------------------------------------------
# Convenience aliases (read when ICON_API_KEY is not set)
# ---------------------------------------------------------------------------
# MINIMAX_API_KEY=sk-cp-your-key-here
# MINIMAX_API_HOST=https://api.minimaxi.com
# DASHSCOPE_API_KEY=sk-xxxxx                 # provider=qwen
# ARK_API_KEY=xxxxxxxx                       # provider=ark

# ---------------------------------------------------------------------------
# Provider quick reference
# ---------------------------------------------------------------------------
# MiniMax:
#   Key:  https://platform.minimaxi.com/user-center/basic-information/interface-key
#   Provider=minimax, model=image-01 (or image-01-live)
#
# Qwen / Aliyun DashScope:
#   Key:  https://bailian.console.aliyun.com/?apiKey=1
#   Docs: https://help.aliyun.com/zh/model-studio/qwen-image-api
#   Provider=qwen, model=qwen-image-3.0-pro, VLM=qwen-vl-max
#
# Volcengine Ark / Seedream (strong icon quality, cheap):
#   Key:  https://console.volcengine.com/ark
#   Provider=ark, model=doubao-seedream-5-0-pro-260628
#   Or use the OpenAI-compatible route:
#     ICON_PROVIDER=openai-compatible
#     ICON_API_HOST=https://ark.cn-beijing.volces.com/api/v3
#     ICON_MODEL=doubao-seedream-5-0-pro-260628
#
# OpenAI official:
#   Key:  https://platform.openai.com/api-keys
#   Provider=openai, model=gpt-image-1  (supports native transparent background)
#
# Other OpenAI-compatible gateways (SiliconFlow, Together, self-hosted):
#   ICON_PROVIDER=openai-compatible
#   ICON_API_HOST=https://api.siliconflow.cn
#   ICON_MODEL=Kolors
#   ICON_VLM_MODEL=Qwen/Qwen2-VL-72B-Instruct