# tech-scout-daily 配置模板
# 复制到 ~/.config/tech-scout-daily/env 并 chmod 600
# （技能目录被 npx skills 更新覆盖，密钥请放在 ~/.config 下）

# ── crawl4ai（全量源必需；不配时只能拿到 3/7 源）──
CRAWL4AI_URL=http://<your-crawl4ai-host>:11235
CRAWL4AI_TOKEN=<bearer token>

# ── LLM 翻译 + 评分（可选；不配则翻译退回 Google、评分退回关键词启发式）──
LLM_API_URL=https://your-openai-compatible-endpoint/v1
LLM_MODEL_NAME=qwen3.7-plus
LLM_API_KEY=sk-...
# 翻译单独用快模型，避免长文本翻译被 thinking 拖慢
TRANSLATE_LLM_MODEL=qwen3.6-flash
# 评分模型（不配则复用 TRANSLATE_LLM_MODEL）
RATE_LLM_MODEL=qwen3.6-flash

# ── 其他可选 ──
# 强制忽略当天 HTML 缓存，重新抓取
# TECH_SCOUT_REFRESH=1
# 跳过 SSL 校验（受限网络）
# TECH_SCOUT_INSECURE_SSL=1
