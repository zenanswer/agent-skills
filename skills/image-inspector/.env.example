# Image Inspector — 环境配置模板
#
# 复制为 .env 后填入真实值；shell 环境变量优先于本文件。
#   cp .env.example .env
#
# 必填
LLM_API_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen3.7-plus
LLM_API_KEY=sk-your-key-here

# 可选
# 主 provider 失败时依次重试（429/5xx/超时）
# VISION_FALLBACKS=[{"url":"https://dashscope.aliyuncs.com/compatible-mode/v1","model":"qwen3-vl-plus","key":"sk-xxx"}]

# 远程图片本地抓取后转 base64（阿里云 Token Plan 必须 true）
VISION_FETCH_REMOTE=true

# 发送前等比缩放到长边不超过该值
VISION_MAX_EDGE=2048

# 单次请求超时（秒）
VISION_TIMEOUT=180

# 公司网络代理（脚本自动读取标准变量）
# HTTPS_PROXY=http://10.10.11.13:7897
# HTTP_PROXY=http://10.10.11.13:7897
# NO_PROXY=localhost,127.0.0.1,10.0.0.0/8